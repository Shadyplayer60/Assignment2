@page
@model Assignment2.Pages.IndexModel

<div class="border bg-light p-3 m-3">
    <h4>POSTBACK Form (Index → Privacy)</h4>
    <form method="post">
        <div class="mb-3">
            <label class="form-label">Name:</label>
            <input asp-for="Person.Name" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Age:</label>
            <input asp-for="Person.Age" type="number" class="form-control" />
        </div>
        <button type="submit" class="btn btn-info">Submit POSTBACK</button>
    </form>
</div>
